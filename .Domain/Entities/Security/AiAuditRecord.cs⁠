using System;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;

namespace Chandanala.ERP.Domain.Entities.Security
{
    public class AiAuditRecord
    {
        public Guid Id { get; private set; }
        public Guid TenantId { get; private set; }
        public Guid ProposalId { get; private set; }
        public string Status { get; private set; } // e.g., "Blocked", "Executed"
        public string Reason { get; private set; } // e.g., "VGP Failure", "Success"
        public DateTimeOffset Timestamp { get; private set; }
        
        // Tamper-Evidence Fields
        public string PreviousHash { get; private set; }
        public string CurrentHash { get; private set; }

        protected AiAuditRecord() { } // EF Core Constructor

        public static AiAuditRecord Create(
            Guid tenantId, 
            Guid proposalId, 
            string status, 
            string reason, 
            string previousHash)
        {
            var record = new AiAuditRecord
            {
                Id = Guid.NewGuid(),
                TenantId = tenantId,
                ProposalId = proposalId,
                Status = status,
                Reason = reason,
                Timestamp = DateTimeOffset.UtcNow,
                PreviousHash = previousHash ?? string.Empty
            };

            record.CurrentHash = record.ComputeHash();
            return record;
        }

        private string ComputeHash()
        {
            var rawData = $"{Id}{TenantId}{ProposalId}{Status}{Reason}{Timestamp:O}{PreviousHash}";
            
            using var sha256 = SHA256.Create();
            var bytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(rawData));
            return Convert.ToHexString(bytes);
        }
    }
}
