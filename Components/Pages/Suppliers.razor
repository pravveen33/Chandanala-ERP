@page "/suppliers"
@rendermode InteractiveServer

@using Chandanala.ERP.Web.Models
@using Chandanala.ERP.Web.Services

@inject SupplierService SupplierService
@inject IJSRuntime JS
@inject ILogger<Suppliers> Logger

<PageTitle>Suppliers</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">Supplier Master</h3>
        <small class="text-muted">Manage pharmacy suppliers, credit terms, and statutory details.</small>
    </div>
    <div class="btn-toolbar gap-2">
        <button class="btn btn-primary" @onclick="ShowAddForm">
            Add Supplier
        </button>
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@isLoading">
            Refresh
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @MessageAlertClass alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" @onclick="ClearMessage"></button>
    </div>
}

@if (pendingRequests.Any())
{
    <div class="card shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
            <strong>Pending Approvals</strong>
            <span class="badge text-bg-warning">@pendingRequests.Count awaiting review</span>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                These edits touch a regulated field (GSTIN or Drug License Number) and are held here until approved — the distributor record is unchanged until then.
            </p>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Distributor</th>
                            <th>Changed Field(s)</th>
                            <th>Requested</th>
                            <th>Reason</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in pendingRequests)
                        {
                            <tr>
                                <td>@(request.Supplier?.SupplierName ?? $"Supplier #{request.SupplierId}")</td>
                                <td><span class="badge text-bg-secondary">@request.ChangedRegulatedFields</span></td>
                                <td>@request.RequestedAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(request.RequestReason) ? "—" : request.RequestReason)</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-success me-1" disabled="@isReviewing" @onclick="() => ApproveRequestAsync(request.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@isReviewing" @onclick="() => RejectRequestAsync(request.Id)">Reject</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (showForm)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <strong>@(editingId is null ? "Add Supplier" : "Edit Supplier")</strong>
            <button type="button" class="btn btn-sm btn-light" @onclick="CancelEdit">Close</button>
        </div>
        <div class="card-body">
            <EditForm Model="@supplier" OnValidSubmit="SaveSupplierAsync" FormName="SupplierForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(validationMessage))
                {
                    <div class="alert alert-danger">@validationMessage</div>
                }

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Supplier Code *</label>
                        <InputText class="form-control" @bind-Value="supplier.SupplierCode" maxlength="30" />
                        <ValidationMessage For="@(() => supplier.SupplierCode)" />
                    </div>

                    <div class="col-md-5 mb-3">
                        <label class="form-label">Supplier Name *</label>
                        <InputText class="form-control" @bind-Value="supplier.SupplierName" maxlength="200" />
                        <ValidationMessage For="@(() => supplier.SupplierName)" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Contact Person</label>
                        <InputText class="form-control" @bind-Value="supplier.ContactPerson" maxlength="200" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Mobile</label>
                        <InputText class="form-control" @bind-Value="supplier.MobileNumber" maxlength="20" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="supplier.Email" maxlength="100" />
                        <ValidationMessage For="@(() => supplier.Email)" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">GSTIN</label>
                        <InputText class="form-control" @bind-Value="supplier.GSTIN" maxlength="15" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Drug License No.</label>
                        <InputText class="form-control" @bind-Value="supplier.DrugLicenseNumber" maxlength="100" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Address</label>
                        <InputTextArea class="form-control" @bind-Value="supplier.Address" rows="2" maxlength="500" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">City</label>
                        <InputText class="form-control" @bind-Value="supplier.City" maxlength="100" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">State</label>
                        <InputText class="form-control" @bind-Value="supplier.State" maxlength="100" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Pincode</label>
                        <InputText class="form-control" @bind-Value="supplier.Pincode" maxlength="10" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Credit Days</label>
                        <InputNumber class="form-control" @bind-Value="supplier.CreditDays" />
                        <ValidationMessage For="@(() => supplier.CreditDays)" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Credit Limit</label>
                        <InputNumber class="form-control" @bind-Value="supplier.CreditLimit" />
                        <ValidationMessage For="@(() => supplier.CreditLimit)" />
                    </div>

                    <div class="col-md-3 mb-3 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="supplier.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            @(editingId is null ? "Save Supplier" : "Update Supplier")
                        }
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <strong>Supplier List (@FilteredSuppliers.Count() total)</strong>
            <div class="d-flex flex-wrap gap-2">
                <input class="form-control" style="min-width: 280px;" placeholder="Search code, name, mobile, GSTIN..." value="@searchText" @oninput="OnSearchChanged" />
                <select class="form-select" style="width: 100px;" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!FilteredSuppliers.Any())
        {
            <p class="text-muted mb-0">No suppliers found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th role="button" @onclick='() => SortBy("SupplierCode")'>Supplier Code @SortMarker("SupplierCode")</th>
                            <th role="button" @onclick='() => SortBy("SupplierName")'>Supplier Name @SortMarker("SupplierName")</th>
                            <th role="button" @onclick='() => SortBy("ContactPerson")'>Contact Person @SortMarker("ContactPerson")</th>
                            <th role="button" @onclick='() => SortBy("MobileNumber")'>Mobile @SortMarker("MobileNumber")</th>
                            <th>GSTIN</th>
                            <th role="button" @onclick='() => SortBy("CreditDays")'>Credit Days @SortMarker("CreditDays")</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedSuppliers)
                        {
                            <tr>
                                <td>@item.SupplierCode</td>
                                <td>@item.SupplierName</td>
                                <td>@item.ContactPerson</td>
                                <td>@item.MobileNumber</td>
                                <td>@item.GSTIN</td>
                                <td>@item.CreditDays</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSupplier(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSupplierAsync(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="Supplier pages">
                    <ul class="pagination mb-0 flex-wrap">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                        </li>
                        @for (var i = 1; i <= totalPages; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@code {
    private List<Supplier> suppliers = new();
    private List<SupplierChangeRequest> pendingRequests = new();
    private Supplier supplier = new();

    private string searchText = string.Empty;
    private string message = string.Empty;
    private string validationMessage = string.Empty;

    private enum MessageKind { Success, Error, Info }
    
    private string MessageAlertClass = "";
    private MessageKind messageKind = MessageKind.Success;
    private bool isLoading = true;
    private bool isSaving;
    private bool isReviewing;
    private bool showForm;

    private int? editingId;
    private int currentPage = 1;
    private int pageSize = 10;

    private string sortColumn = "SupplierName";
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliersAsync();
        await LoadPendingRequestsAsync();
    }

    private async Task LoadPendingRequestsAsync()
    {
        try
        {
            pendingRequests = await SupplierService.GetPendingChangeRequestsAsync();
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while loading pending supplier change requests");
            ShowError("Could not load pending approvals. Please refresh the page.");
        }
    }

    private async Task LoadSuppliersAsync()
    {
        isLoading = true;
        try
        {
            suppliers = await SupplierService.GetAllAsync();
            EnsureValidPage();
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while loading suppliers");
            ShowError("Could not load suppliers. Please refresh the page.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<Supplier> FilteredSuppliers => suppliers.Where(s =>
        string.IsNullOrWhiteSpace(searchText) ||
        Contains(s.SupplierCode, searchText) ||
        Contains(s.SupplierName, searchText) ||
        Contains(s.ContactPerson, searchText) ||
        Contains(s.MobileNumber, searchText) ||
        Contains(s.GSTIN, searchText) ||
        Contains(s.City, searchText) ||
        Contains(s.State, searchText));

    private IEnumerable<Supplier> SortedSuppliers
    {
        get
        {
            IOrderedEnumerable<Supplier> sorted = sortColumn switch
            {
                "SupplierCode" => FilteredSuppliers.OrderBy(s => s.SupplierCode),
                "ContactPerson" => FilteredSuppliers.OrderBy(s => s.ContactPerson),
                "MobileNumber" => FilteredSuppliers.OrderBy(s => s.MobileNumber),
                "CreditDays" => FilteredSuppliers.OrderBy(s => s.CreditDays),
                _ => FilteredSuppliers.OrderBy(s => s.SupplierName)
            };

            return sortAscending ? sorted : sorted.Reverse();
        }
    }

    private int totalPages => Math.Max(1, (int)Math.Ceiling(FilteredSuppliers.Count() / (double)pageSize));

    private IEnumerable<Supplier> PagedSuppliers => SortedSuppliers
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false;

    private string SortMarker(string column) => sortColumn == column ? (sortAscending ? "▲" : "▼") : string.Empty;

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedPageSize))
        {
            pageSize = selectedPageSize;
            currentPage = 1;
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages)
        {
            return;
        }

        currentPage = page;
    }

    private void ShowAddForm()
    {
        supplier = new Supplier();
        editingId = null;
        validationMessage = string.Empty;
        showForm = true;
    }

    private void EditSupplier(Supplier selected)
    {
        supplier = CopySupplier(selected);
        editingId = selected.Id;
        validationMessage = string.Empty;
        showForm = true;
        ClearMessage();
    }

    private async Task SaveSupplierAsync()
    {
        isSaving = true;
        validationMessage = string.Empty;
        ClearMessage();

        try
        {
            if (editingId is null)
            {
                await SupplierService.CreateAsync(supplier);
                ShowSuccess("Supplier Saved Successfully.");
            }
            else
            {
                await SupplierService.UpdateAsync(supplier);
                ShowSuccess("Supplier Updated Successfully.");
            }

            await LoadSuppliersAsync();
            CancelEdit();
        }
        catch (SupplierApprovalRequiredException ex)
        {
            ShowInfo($"This change touches a regulated field ({ex.ChangedFields}) and has been submitted for approval (request #{ex.RequestId}). The distributor record is unchanged until it's reviewed.");
            await LoadPendingRequestsAsync();
            CancelEdit();
        }
        catch (SupplierValidationException ex)
        {
            validationMessage = ex.Message;
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while saving supplier");
            ShowError("Something went wrong while saving this supplier. Please try again.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ApproveRequestAsync(int requestId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Approve this change? It will be applied to the distributor immediately.");
        if (!confirmed)
        {
            return;
        }

        isReviewing = true;
        try
        {
            await SupplierService.ApproveChangeRequestAsync(requestId);
            ShowSuccess("Change request approved and applied.");
            await LoadSuppliersAsync();
            await LoadPendingRequestsAsync();
        }
        catch (SupplierValidationException ex)
        {
            ShowError(ex.Message);
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while approving supplier change request {RequestId}", requestId);
            ShowError("Something went wrong while approving this request. Please try again.");
        }
        finally
        {
            isReviewing = false;
        }
    }

    private async Task RejectRequestAsync(int requestId)
    {
        var reason = await JS.InvokeAsync<string?>("prompt", "Reason for rejecting this change request:");
        if (string.IsNullOrWhiteSpace(reason))
        {
            return;
        }

        isReviewing = true;
        try
        {
            await SupplierService.RejectChangeRequestAsync(requestId, reason);
            ShowSuccess("Change request rejected. No changes were made to the distributor.");
            await LoadPendingRequestsAsync();
        }
        catch (SupplierValidationException ex)
        {
            ShowError(ex.Message);
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while rejecting supplier change request {RequestId}", requestId);
            ShowError("Something went wrong while rejecting this request. Please try again.");
        }
        finally
        {
            isReviewing = false;
        }
    }

    private async Task DeleteSupplierAsync(Supplier selected)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete supplier \"{selected.SupplierName}\"?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await SupplierService.DeleteAsync(selected.Id);
            ShowSuccess("Supplier Deleted Successfully.");
            await LoadSuppliersAsync();

            if (editingId == selected.Id)
            {
                CancelEdit();
            }
        }
        catch (SupplierValidationException ex)
        {
            ShowError(ex.Message);
        }
        catch (SupplierServiceException ex)
        {
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while deleting supplier {SupplierId}", selected.Id);
            ShowError("Something went wrong while deleting this supplier. Please try again.");
        }
    }

    private async Task RefreshAsync()
    {
        await LoadSuppliersAsync();
        ShowSuccess("Supplier list refreshed.");
    }

    private void CancelEdit()
    {
        supplier = new Supplier();
        editingId = null;
        validationMessage = string.Empty;
        showForm = false;
    }

    private void EnsureValidPage()
    {
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private static Supplier CopySupplier(Supplier source) => new()
    {
        Id = source.Id,
        SupplierCode = source.SupplierCode,
        SupplierName = source.SupplierName,
        GSTIN = source.GSTIN,
        DrugLicenseNumber = source.DrugLicenseNumber,
        ContactPerson = source.ContactPerson,
        MobileNumber = source.MobileNumber,
        Email = source.Email,
        Address = source.Address,
        City = source.City,
        State = source.State,
        Pincode = source.Pincode,
        CreditDays = source.CreditDays,
        CreditLimit = source.CreditLimit,
        IsActive = source.IsActive,
        IsDeleted = source.IsDeleted,
        CreatedAt = source.CreatedAt,
        UpdatedAt = source.UpdatedAt,
        CurrentVersion = source.CurrentVersion,
        RowVersion = source.RowVersion
    };

    private void ShowSuccess(string text)
    {
        message = text;
        mymessage = Messagekind."success";
    }

    private void ShowInfo(string text)
    {
        message = text;
        mymessage = Messagekind."success";
    }

    private void ShowError(string text)
    {
        message = text;
        messageKind = "error";
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }
}
