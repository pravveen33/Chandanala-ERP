@page "/new-bill"

@using Chandanala.ERP.Web.Services
@using Chandanala.ERP.Web.Models.Models

@inject BillService BillService
@inject NavigationManager Navigation

<h3>Enter Pharmacy Receipt</h3>

<EditForm Model="@newBill" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Payment Mode</label>
        <InputText class="form-control"
                   @bind-Value="newBill.PaymentMode" />
    </div>

    <div class="mb-3">
        <label>Total Amount</label>
        <InputNumber class="form-control"
                     @bind-Value="newBill.TotalAmount" />
    </div>

    <button class="btn btn-primary" type="submit">
        Save Bill
    </button>
</EditForm>

@code {

    private Bill newBill = new();

    private async Task HandleSubmit()
    {
        await BillService.AddBillAsync(newBill);

        Navigation.NavigateTo("/bills");
    }

}